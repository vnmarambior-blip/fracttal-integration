{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run All Sync (PRODUCCIÓN - Default)",
            "type": "python",
            "request": "launch",
            "module": "run_all_sync",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SYNC_DRY_RUN": "false"
            }
        },
        {
            "name": "🚀 Run All Sync (PRODUCCIÓN + Reporte)",
            "type": "python",
            "request": "launch",
            "module": "run_all_sync",
            "args": ["--report", "ejecucion_${input:date}.md"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SYNC_DRY_RUN": "false"
            }
        },
        {
            "name": "🧪 Run All Sync (DRY-RUN)",
            "type": "python",
            "request": "launch",
            "module": "run_all_sync",
            "args": ["--dry-run"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SYNC_DRY_RUN": "true"
            }
        },
        {
            "name": "🔧 Run MyDevelon Only (PRODUCCIÓN)",
            "type": "python",
            "request": "launch",
            "module": "run_mydevelon_sync",
            "args": ["--live"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SYNC_DRY_RUN": "false"
            }
        },
        {
            "name": "🔧 Run Komtrax Only (PRODUCCIÓN)",
            "type": "python",
            "request": "launch",
            "module": "run_komtrax_sync",
            "args": ["--live"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SYNC_DRY_RUN": "false"
            }
        },
        {
            "name": "🧪 Run Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "date",
            "type": "promptString",
            "description": "Fecha para el reporte (YYYYMMDD)",
            "default": "20260925"
        }
    ]
}