{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Run All Sync (PRODUCCIÓN - Default)",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": ["run_all_sync.py"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Ejecuta MyDevelon + Komtrax EN VIVO -> Fracttal (PRODUCCIÓN por defecto)"
        },
        {
            "label": "🚀 Run All Sync PRODUCCIÓN + Reporte",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "run_all_sync.py",
                "--report",
                "ejecucion_${input:date}.md"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Ejecución completa en vivo con reporte markdown"
        },
        {
            "label": "🧪 Run All Sync (DRY-RUN)",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": ["run_all_sync.py", "--dry-run"],
            "group": "test",
            "problemMatcher": [],
            "detail": "Simulación: MyDevelon fixture + Komtrax fixture"
        },
        {
            "label": "🔧 MyDevelon Only (PRODUCCIÓN)",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": ["run_mydevelon_sync.py", "--live"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "🔧 Komtrax Only (PRODUCCIÓN)",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": ["run_komtrax_sync.py", "--live"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "🧪 Run All Tests",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": ["-m", "pytest", "-q"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "📦 Install Dependencies",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\pip.exe",
            "args": ["install", "-r", "requirements.txt"],
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "date",
            "type": "promptString",
            "description": "Fecha para el reporte (YYYYMMDD)",
            "default": "20260925"
        }
    ]
}