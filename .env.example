FRACTTAL_CLIENT_ID=
FRACTTAL_CLIENT_SECRET=
FRACTTAL_REDIRECT_URI=http://localhost:8000/callback

MYDEVELON_CLIENT_ID=
MYDEVELON_CLIENT_SECRET=

# Solo para ejecutar fuera de este computador. No publicar este valor.
# SQL_CONNECTION_STRING=Server=...;Database=...;User Id=...;Password=...;Encrypt=yes;

# true = revisa y registra, pero no escribe en Fracttal (valor recomendado
# hasta completar las pruebas). false = permite escrituras autorizadas.
SYNC_DRY_RUN=true

# Fuente MyDevelon: file = fixture local sin red (desarrollo/pruebas),
# live = API real con cuota mínima (ver --live). 1 consulta / 15 min.
MYDEVELON_SOURCE=file
MYDEVELON_FIXTURE=mydevelon_fleet_minutes.xml
MYDEVELON_STATE_FILE=.mydevelon_last_fetch.txt
MYDEVELON_MIN_INTERVAL_SECONDS=900
MYDEVELON_TOKEN_TTL_SECONDS=1800
